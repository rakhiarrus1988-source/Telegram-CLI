# Telegram CLI - Environment Variables Configuration
# Copy this file to .env and fill in your values

# ============================================
# Telegram API Credentials (REQUIRED)
# ============================================
# Get these from: https://my.telegram.org/apps
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# ============================================
# Master Password (OPTIONAL)
# ============================================
# If not set, script will ask on first run
# This password encrypts the password_store.enc file
MASTER_PASSWORD=

# ============================================
# Default Settings (OPTIONAL)
# ============================================

# Default channel/group for uploads (username or invite link)
# If empty, script will ask each time
DEFAULT_UPLOAD_CHANNEL=

# Default download directory (absolute path)
# Default: ./data/downloads/
DOWNLOAD_DIR=

# Maximum parallel connections per upload (4-6 recommended)
# Default: 4
MAX_PARALLEL_CONNECTIONS=4

# ============================================
# Advanced Settings (OPTIONAL)
# ============================================

# Enable/disable encryption (true/false)
# Default: true
ENABLE_ENCRYPTION=true

# Enable/disable account rotation (true/false)
# Default: true
ENABLE_ACCOUNT_ROTATION=true

# Random sleep between operations (in seconds)
# Format: min,max (e.g., 5,30)
# Default: 5,15
RANDOM_SLEEP_RANGE=5,15

# Log level (DEBUG, INFO, WARNING, ERROR)
# Default: INFO
LOG_LEVEL=INFO

# Database path (absolute path)
# Default: ./data/database/telegram_cli.db
DATABASE_PATH=

# Session directory (absolute path)
# Default: ./data/sessions/
SESSION_DIR=

# ============================================
# Proxy Settings (Coming Soon)
# ============================================
# Uncomment when proxy support is added

# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ============================================
# Scheduled Jobs (OPTIONAL)
# ============================================
# Enable/disable auto-scheduler
# Default: false
ENABLE_SCHEDULER=false

# ============================================
# Performance Tuning
# ============================================

# Chunk size for upload/download (in MB)
# Default: 10
CHUNK_SIZE_MB=10

# Maximum retries on failure
# Default: 3
MAX_RETRIES=3

# Timeout for API requests (in seconds)
# Default: 60
API_TIMEOUT=60